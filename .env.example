# Project Dawn server — environment overrides.
# Copy to .env (which is gitignored) and edit. All values can also live in
# config.toml; environment vars win when both are set.

# Path to SQLite database file. Created on first start; migrations apply on boot.
PROJECTDAWN_DATABASE_URL=sqlite://world.db?mode=rwc

# Auth WebSocket bind address (the launcher connects here).
PROJECTDAWN_AUTH_BIND=0.0.0.0:8765

# World UDP bind address (the renet listener). Bind 0.0.0.0 so loopback
# AND the Tailscale interface both accept packets on this port.
PROJECTDAWN_WORLD_BIND=0.0.0.0:7777

# World UDP endpoint advertised to clients in LoginOk.world_endpoint.
# Local dev: 127.0.0.1:7777. On the home Linux box, set to your tailnet
# IP (100.x.y.z:7777) so launcher-spawned game clients can reach it.
PROJECTDAWN_WORLD_ENDPOINT=127.0.0.1:7777

# 32-byte private key for renet's Secure-mode connection tokens.
# REQUIRED — server refuses to start without it. Generate with PowerShell:
#   $env:PROJECTDAWN_NETCODE_KEY = (1..32 | ForEach { '{0:x2}' -f (Get-Random -Max 256) }) -join ''
# or POSIX:
#   PROJECTDAWN_NETCODE_KEY=$(openssl rand -hex 32)
# Format: 64-char lowercase hex (32 bytes).
PROJECTDAWN_NETCODE_KEY=

# Minimum acceptable client_version (semver). Older logins are rejected.
PROJECTDAWN_MIN_CLIENT_VERSION=0.1.0

# Logging filter — see tracing-subscriber EnvFilter syntax.
RUST_LOG=projectdawn_server=info,sqlx=warn
