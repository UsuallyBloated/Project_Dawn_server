# Project Dawn server — environment overrides.
# Copy to .env (which is gitignored) and edit. All values can also live in
# config.toml; environment vars win when both are set.

# Path to SQLite database file. Created on first start; migrations apply on boot.
PROJECTDAWN_DATABASE_URL=sqlite://world.db?mode=rwc

# Auth WebSocket bind address (the launcher connects here).
PROJECTDAWN_AUTH_BIND=0.0.0.0:8765

# World UDP endpoint — handed back to the launcher in LoginOk.world_endpoint.
# Not yet bound by the server; listed so the contract is visible.
PROJECTDAWN_WORLD_ENDPOINT=127.0.0.1:7777

# Minimum acceptable client_version (semver). Older logins are rejected.
PROJECTDAWN_MIN_CLIENT_VERSION=0.1.0

# Logging filter — see tracing-subscriber EnvFilter syntax.
RUST_LOG=projectdawn_server=info,sqlx=warn
