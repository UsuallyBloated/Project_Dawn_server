/target/
/**/target/

# SQLite databases (created at runtime / per-test)
*.db
*.db-journal
*.db-shm
*.db-wal
# Hand-taken DB snapshots before a risky migration (e.g. world.db.bak-pre0009).
*.db.bak*

# Local config / secrets
.env
config.toml

# Editor
.vscode/
.idea/
*.swp

# Captured server logs (e.g. `cargo run -p projectdawn-server | Tee-Object server.log`)
*.log

# Local dev tools kept at the repo root for convenience (sqlite CLI family,
# rcedit). Real build artifacts live under /target/, already ignored above.
*.exe
